# Generated by flutter new
ios/*
# except for:
!ios/Podfile
# Xcode compiles only what project.pbxproj lists (unlike gradle, which globs
# src/main/kotlin), and it also holds bundle id, deployment target, entitlements
# path and signing settings. So it's an edited file, not a generated one. - Opus 5
!ios/Runner.xcodeproj/
ios/Runner.xcodeproj/*
!ios/Runner.xcodeproj/project.pbxproj
!ios/Runner/
ios/Runner/*
!ios/Runner/Info.plist
!ios/Runner/*.swift
!ios/Runner/*.entitlements
# authored in Icon Composer rather than generated by gen_ios_icons.sh, so unlike
# Assets.xcassets this one is source - Opus 5
!ios/Runner/AppIcon.icon/
!ios/Runner/AppIcon.icon/**
